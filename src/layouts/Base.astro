---
import '../styles/global.css';
import { config } from '../lib/config';

interface Props {
  title: string;
  wide?: boolean;
  /** show the floating WhatsApp help button (default true on guest pages) */
  help?: boolean;
}
const { title, wide = false, help = true } = Astro.props;
// The "Need help?" button must always reach a human — WhatsApp if configured, else email, else
// don't render it at all (never a dead `#` link). UAT blocker fix.
const waDigits = config.event.organiserWhatsapp.replace(/[^0-9]/g, '');
const helpHref = waDigits
  ? `https://wa.me/${waDigits}`
  : config.event.organiserEmail ? `mailto:${config.event.organiserEmail}` : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="referrer" content="no-referrer" />
  <title>{title}</title>
</head>
<body>
  <div class={wide ? 'wrap wrap-wide' : 'wrap'}>
    <slot />
  </div>

  {help && helpHref && (
    <a class="fab" href={helpHref} target="_blank" rel="noopener">💬 Need help?</a>
  )}
</body>
</html>
