---
import Base from '../layouts/Base.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
import { config } from '../lib/config';
import { CSRF_COOKIE, issueCsrf } from '../lib/csrf';

// If a previous POST failed validation, /api/register set a one-shot "flash" cookie with the
// errors + submitted values so we can re-render inline (no data lost, works without JS).
let flash: { errors?: Record<string, string>; values?: Record<string, string> } = {};
const flashRaw = Astro.cookies.get('ftc_form')?.value;
if (flashRaw) {
  try { flash = JSON.parse(flashRaw); } catch { /* ignore */ }
  Astro.cookies.delete('ftc_form', { path: '/' });
}

// CSRF: set the cookie and render the SAME token into a hidden field (double-submit).
const csrf = issueCsrf();
Astro.cookies.set(CSRF_COOKIE, csrf, {
  path: '/', httpOnly: true, sameSite: 'strict', secure: config.isProd, maxAge: 7200,
});
const nonce = issueCsrf(); // submission nonce (idempotency)

const { town, birthdayName, birthdayAge } = config.event;
---
<Base title="Register travel details">
  <h1>Register travel details</h1>
  <p class="muted small">{birthdayName}'s {birthdayAge}th · {town}. Takes about 5 minutes — you can edit later, and it's fine if some details aren't final yet.</p>

  <RegistrationForm
    mode="create"
    action="/api/register"
    csrf={csrf}
    nonce={nonce}
    values={flash.values ?? {}}
    errors={flash.errors ?? {}}
  />
</Base>
