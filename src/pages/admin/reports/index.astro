---
import Base from '../../../layouts/Base.astro';
import NeedsYou from '../../../components/NeedsYou.astro';
import { requireSession } from '../../../lib/auth';
import { store } from '../../../lib/store';
import { computeJobs } from '../../../lib/tasks';
import { schedule, seatDemand, chaseList, headcount } from '../../../lib/reports';
import { humanDate } from '../../../lib/dates';

if (!requireSession(Astro.cookies, new Date())) return Astro.redirect('/admin/login');

const [regs, bookings] = await Promise.all([store.listRegistrations(), store.listBookings()]);
const jobs = computeJobs(regs, bookings);
const arrivals = schedule(regs, bookings, 'arrival');
const departures = schedule(regs, bookings, 'departure');
const demand = seatDemand(regs);
const chase = chaseList(regs);
const head = headcount(regs);
const statusChip: Record<string, string> = { confirmed: 'ok', planned: 'plan', requested: 'req', needs_clarification: 'warn', not_required: 'ok', cancelled: 'req' };
---
<Base title="Reports & driver plan" wide help={false}>
  <div class="topbar">
    <a class="btn small btn-ghost" href="/admin">← What needs you</a>
    <h1 style="margin:0; font-size:1.25rem">Reports &amp; driver plan</h1>
    <a class="btn small btn-ghost" href="/admin/reports/run-sheet">🧑‍✈️ Run sheet (print)</a>
  </div>
  <NeedsYou jobs={jobs} />

  <div class="kpis">
    <div class="kpi"><div class="n">{head.totalPeople}</div><div class="l">people registered</div></div>
    <div class="kpi"><div class="n">{head.confirmedPeople}</div><div class="l">confirmed people</div></div>
    <div class="kpi"><div class="n">{regs.length}</div><div class="l">families</div></div>
    <div class="kpi"><div class="n">{chase.length}</div><div class="l">to chase</div></div>
  </div>

  <div class="card">
    <h2 style="margin-top:0">Seat demand by date <span class="muted small">(people needing transport — size vehicles to this)</span></h2>
    {demand.length === 0 ? <p class="muted">No transport demand yet.</p> : (
      <table class="table">
        <thead><tr><th>Date</th><th>Arrivals</th><th>Departures</th><th>Internal</th><th>Total people</th></tr></thead>
        <tbody>{demand.map((d) => (
          <tr><td>{humanDate(d.date)}</td><td>{d.arrival || ''}</td><td>{d.departure || ''}</td><td>{d.internal || ''}</td><td><b>{d.total}</b></td></tr>
        ))}</tbody>
      </table>
    )}
  </div>

  <div class="card">
    <div class="topbar" style="margin:0"><h2 style="margin:0">Arrivals</h2><a class="btn small btn-gold" href="/api/admin/reports/arrivals.csv" style="width:auto">⬇ CSV</a></div>
    {arrivals.length === 0 ? <p class="muted">None yet.</p> : (
      <table class="table">
        <thead><tr><th>Date</th><th>Time</th><th>Guest</th><th>Ppl</th><th>Route</th><th>Flight</th><th>Driver</th><th>Status</th></tr></thead>
        <tbody>{arrivals.map((r) => (
          <tr><td>{humanDate(r.date)}</td><td>{r.time}</td><td>{r.guest}</td><td>{r.people}</td><td>{r.route}</td><td>{r.carrier}</td><td>{r.driver}</td><td><span class={`chip ${statusChip[r.status] ?? 'plan'}`}>{r.status.replace('_', ' ')}</span></td></tr>
        ))}</tbody>
      </table>
    )}
  </div>

  <div class="card">
    <div class="topbar" style="margin:0"><h2 style="margin:0">Departures</h2><a class="btn small btn-gold" href="/api/admin/reports/departures.csv" style="width:auto">⬇ CSV</a></div>
    {departures.length === 0 ? <p class="muted">None yet.</p> : (
      <table class="table">
        <thead><tr><th>Date</th><th>Time</th><th>Guest</th><th>Ppl</th><th>Route</th><th>Flight</th><th>Driver</th><th>Status</th></tr></thead>
        <tbody>{departures.map((r) => (
          <tr><td>{humanDate(r.date)}</td><td>{r.time}</td><td>{r.guest}</td><td>{r.people}</td><td>{r.route}</td><td>{r.carrier}</td><td>{r.driver}</td><td><span class={`chip ${statusChip[r.status] ?? 'plan'}`}>{r.status.replace('_', ' ')}</span></td></tr>
        ))}</tbody>
      </table>
    )}
  </div>

  <div class="card">
    <h2 style="margin-top:0">Chase list <span class="muted small">({chase.length} missing info)</span></h2>
    {chase.length === 0 ? <p class="muted">Nothing to chase — every leg has a date and flight number 🎉</p> : (
      <table class="table">
        <thead><tr><th>Guest</th><th>Contact</th><th>Leg</th><th>Missing</th><th></th></tr></thead>
        <tbody>{chase.map((c) => (
          <tr><td>{c.guest}</td><td class="small">{c.contact}</td><td>{c.direction}</td><td><span class="chip gold">{c.missing}</span></td>
            <td>{c.whatsapp && <a class="btn small btn-ghost" href={c.whatsapp} target="_blank" rel="noopener" style="width:auto">💬</a>}</td></tr>
        ))}</tbody>
      </table>
    )}
  </div>

  <div class="card">
    <a class="btn btn-ghost" href="/api/admin/reports/export.csv">⬇ Full export (every leg, CSV — no tokens or health notes)</a>
  </div>
</Base>
