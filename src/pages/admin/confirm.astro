---
import Base from '../../layouts/Base.astro';
import { config } from '../../lib/config';
import { CSRF_COOKIE, issueCsrf } from '../../lib/csrf';
import { requireSession } from '../../lib/auth';
import { store } from '../../lib/store';
import { confirmableBookings, bookingFamilyMessage, whatsappLink } from '../../lib/vehicles';
import { vehicleLabel } from '../../lib/planner';
import { humanDate } from '../../lib/dates';

if (!requireSession(Astro.cookies, new Date())) return Astro.redirect('/admin/login');

const [bookings, regs] = await Promise.all([store.listBookings(), store.listRegistrations()]);
const byRef = new Map(regs.map((r) => [r.reference_number, r]));
const skip = new Set((Astro.url.searchParams.get('skip') ?? '').split(',').filter(Boolean));
const skipParam = [...skip].join(',');
const pendingAll = confirmableBookings(bookings, regs);
const queue = pendingAll.filter((b) => !skip.has(b.id));
const current = queue[0];
const skippedRemaining = pendingAll.length - queue.length;

const csrf = issueCsrf();
Astro.cookies.set(CSRF_COOKIE, csrf, { path: '/', httpOnly: true, sameSite: 'strict', secure: config.isProd, maxAge: 7200 });

// Post-send flash ("Emailed the Pereira family ✓") set by /api/admin/confirm.
let flash = '';
const f = Astro.cookies.get('ftc_admin_flash')?.value;
if (f) { flash = f; Astro.cookies.delete('ftc_admin_flash', { path: '/' }); }

// Honest progress: total is fixed when the flow starts (carried in ?total); a booking leaves
// pendingAll once its families are emailed, so done reflects real completion (skips don't count).
const total = Number(Astro.url.searchParams.get('total')) || pendingAll.length;
const done = Math.max(0, total - pendingAll.length);
const pct = total ? Math.round((done / total) * 100) : 100;

// Capacity guard: don't let the organiser email a promise the vehicle can't keep.
const curPeople = current ? current.covered_legs.reduce((s, c) => s + c.people, 0) : 0;
const overCapacity = !!current && curPeople > current.seats;

// One cost-free preview + WhatsApp link per covered family.
const previews = current
  ? [...new Set(current.covered_legs.map((c) => c.registration_ref))].map((ref) => {
      const reg = byRef.get(ref);
      const first = reg?.main_contact_first ?? '';
      const msg = bookingFamilyMessage(current, first);
      return { ref, name: reg ? `${reg.main_contact_first} ${reg.main_contact_surname}`.trim() : ref, msg, wa: whatsappLink(reg?.whatsapp_e164 ?? reg?.phone_e164 ?? null, msg) };
    })
  : [];
---
<Base title="Confirm & email" help={false}>
  <div class="jobcard">
    <div class="progress">
      <div class="steplabel"><span>Confirm &amp; email</span><span>{current ? `${queue.length} to go · ${done}/${total} done` : 'Done'}</span></div>
      <div class="bar"><div class="fill" style={`width:${current ? pct : 100}%`}></div></div>
    </div>

    {flash && <div class={flash.startsWith('⚠') ? 'banner warn' : 'banner ok'}>{flash}</div>}

    {!current && skippedRemaining > 0 && (
      <div class="card center">
        <div style="font-size:3rem">⏭</div>
        <h1>{skippedRemaining} still to confirm</h1>
        <p class="muted">You skipped {skippedRemaining} family{skippedRemaining === 1 ? '' : ' groups'}. They haven't been emailed yet.</p>
        <a class="btn btn-primary" href="/admin/confirm">Review the skipped ones</a>
        <a class="btn btn-ghost" href="/admin" style="margin-top:10px">Back to What needs you</a>
      </div>
    )}
    {!current && skippedRemaining === 0 && (
      <div class="card center">
        <div style="font-size:3rem">🎉</div>
        <h1>Families told</h1>
        <p class="muted">Every booking with a driver has been confirmed.</p>
        <a class="btn btn-ghost" href="/admin">Back to What needs you</a>
      </div>
    )}

    {current && (
      <div class="card">
        <p class="ts muted" style="margin:0">{humanDate(current.date)} · {current.id.split('-').pop()}</p>
        <p class="jobbig">{current.route_from} → {current.route_to}</p>
        <p class="small muted" style="margin:0 0 8px">{vehicleLabel(current.vehicle_type)}{current.driver_name ? ` · driver ${current.driver_name}` : ''}</p>

        {previews.map((p) => (
          <div class="banner ok" style="text-align:left">
            <b>To {p.name}</b> — this is what they'll receive:
            <pre style="white-space:pre-wrap; font-family:inherit; background:#fff; border:1px solid var(--line); border-radius:8px; padding:10px 12px; margin-top:8px; font-size:.88rem">{p.msg}</pre>
            {p.wa && <a class="btn small btn-ghost" href={p.wa} target="_blank" rel="noopener" style="width:auto; margin-top:6px">💬 Send on WhatsApp instead</a>}
          </div>
        ))}
        <p class="hint">🔒 No cost, operator or budget is included.</p>

        {overCapacity && (
          <div class="banner warn"><b>⚠ Over capacity:</b> this vehicle seats {current.seats} but is carrying {curPeople} people.
          Fix the booking before emailing the family — don't promise a seat that isn't there.
          <a href={`/admin/vehicles/${current.id}`}>Open the booking →</a></div>
        )}

        <form method="POST" action="/api/admin/confirm">
          <input type="hidden" name="csrf_token" value={csrf} />
          <input type="hidden" name="id" value={current.id} />
          <input type="hidden" name="skip" value={skipParam} />
          <input type="hidden" name="total" value={total} />
          <div class="btn-row" style="margin-top:6px">
            <a class="btn btn-ghost" href={`/admin/confirm?total=${total}&skip=${[skipParam, current.id].filter(Boolean).join(',')}`}>Skip</a>
            {overCapacity
              ? <a class="btn btn-gold" href={`/admin/vehicles/${current.id}`}>Fix capacity first</a>
              : <button type="submit" class="btn btn-primary">Send email &amp; next →</button>}
          </div>
        </form>
      </div>
    )}
  </div>
</Base>
