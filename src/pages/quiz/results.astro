---
// PROTECTED (quiz password or admin): the live results. Shared ranks for ties, the tiebreak guess and
// how far it was, top-3 podium, and which questions Sybil has not answered or answers still unchecked.
import Base from '../../layouts/Base.astro';
import { config } from '../../lib/config';
import { store } from '../../lib/store';
import { CSRF_COOKIE, issueCsrf } from '../../lib/csrf';
import { quizHost, touchQuizHost } from '../../lib/quiz-auth';
import { QUESTIONS, SCORED, buildBoard, type QuizEntry, type QuizState, type Truths } from '../../lib/quiz';
import type { Decisions } from '../../lib/quiz-match';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const now = new Date();
const role = quizHost(Astro.cookies, now);
if (!role) return Astro.redirect('/quiz/login?next=results');
touchQuizHost(Astro.cookies, role, now);

const [truths, decisions, entries, state] = await Promise.all([
  store.getQuiz<Truths>('truths').then((t) => t ?? {}),
  store.getQuiz<Decisions>('decisions').then((d) => d ?? {}),
  store.listQuizEntries<QuizEntry>(),
  store.getQuiz<QuizState>('state').then((s) => s ?? { open: true }),
]);
const board = buildBoard(entries, truths, decisions);
const answered = Object.keys(truths).length > 0;
const podium = board.rows.filter((r) => r.rank <= 3);
const live = Astro.url.searchParams.get('live') === '1';
const cleared = Astro.url.searchParams.get('cleared');
const num = (id: string) => QUESTIONS.findIndex((q) => q.id === id) + 1;
const mark = (v: string) => (v === 'match' ? '✓' : v === 'maybe' ? '?' : '✗');
const away = (d: number) => (d === Infinity ? 'no guess' : d === 0 ? 'exact!' : `off by ${d.toLocaleString('en-IN')}`);

const csrf = issueCsrf();
Astro.cookies.set(CSRF_COOKIE, csrf, { path: '/', httpOnly: true, sameSite: 'strict', secure: config.isProd, maxAge: 7200 });
---
<Base title="Quiz results" wide help={false}>
  {live && <meta http-equiv="refresh" content="15" />}
  <div class="hero">
    <div class="kicker">Birthday quiz · results</div>
    <h1>Who knows Sybil best?</h1>
    <p>{entries.length} guest{entries.length === 1 ? '' : 's'} · {SCORED.length} questions</p>
  </div>

  <p class="nav">
    <a href="/quiz/sybil">← Sybil's page</a>
    <a href={live ? '/quiz/results' : '/quiz/results?live=1'}>{live ? 'Stop auto-refresh' : 'Auto-refresh (15s)'}</a>
    <a href="/quiz/results">Refresh</a>
    {role === 'quiz' && (
      <form method="POST" action="/api/quiz/logout" style="display:inline"><input type="hidden" name="csrf_token" value={csrf} /><button class="btn btn-ghost sm" type="submit">Log out</button></form>
    )}
  </p>

  {cleared && cleared !== 'no' && <div class="banner ok">Deleted {cleared} guest entr{cleared === '1' ? 'y' : 'ies'}.</div>}
  {cleared === 'no' && <div class="banner warn">Nothing deleted. Type DELETE (or RESET) in capitals to confirm.</div>}
  {cleared && cleared !== 'no' && Astro.url.searchParams.get('reset') === '1' && <div class="banner ok">Quiz reset: Sybil's answers cleared and entries are open again.</div>}

  <div class={`banner ${state.open ? 'info' : 'warn'}`}>
    <form method="POST" action="/api/quiz/status" class="row">
      <input type="hidden" name="csrf_token" value={csrf} />
      <span>Guest entries are <b>{state.open ? 'OPEN' : 'CLOSED'}</b>.{state.open ? ' Close them before Sybil reads her answers out.' : ' Nobody can send or change answers.'}</span>
      <button class="btn sm btn-primary" name="open" value={state.open ? '0' : '1'} type="submit">{state.open ? 'Close entries' : 'Re-open entries'}</button>
    </form>
  </div>

  {!answered && <div class="banner warn">Sybil has not saved her answers yet, so nobody has points. <a href="/quiz/sybil">Open Sybil's page</a>.</div>}
  {answered && board.unanswered.length > 0 && (
    <div class="banner warn">Sybil has not answered question{board.unanswered.length === 1 ? '' : 's'} {board.unanswered.map(num).join(', ')}. Nobody can score there yet.</div>
  )}
  {answered && board.pending > 0 && (
    <div class="banner warn"><b>{board.pending} answer{board.pending === 1 ? '' : 's'} not checked yet.</b> They count 0 until Sybil taps Same or Different. <a href="/quiz/sybil">Check them</a>.</div>
  )}
  {answered && board.pending === 0 && board.unanswered.length === 0 && entries.length > 0 && <div class="banner ok">Everything is checked. These results are final.</div>}

  {answered && podium.length > 0 && (
    <div class="podium">
      {podium.map((r) => (
        <div class={`pod p${r.rank}`}>
          <div class="medal">{r.rank === 1 ? '🥇' : r.rank === 2 ? '🥈' : '🥉'}</div>
          <div class="pname">{r.name}</div>
          <div class="ppts">{r.points}<small>/{SCORED.length}</small></div>
          {r.tied && <div class="ptie">tied · tiebreak {away(r.tieDiff)}</div>}
        </div>
      ))}
    </div>
  )}

  <div class="card" style="padding:0;overflow-x:auto">
    <table class="table lb">
      <thead><tr><th>#</th><th>Guest</th><th>Answers</th><th>Tiebreak</th><th>Score</th></tr></thead>
      <tbody>
        {board.rows.map((r) => (
          <tr>
            <td class="rank">{r.tied ? `${r.rank}=` : r.rank}</td>
            <td><b>{r.name}</b></td>
            <td class="pills">
              {SCORED.map((q) => <span class={`pill ${r.detail[q.id] ?? 'no'}`} title={`Q${num(q.id)}: ${q.text}`}>{num(q.id)}{mark(r.detail[q.id] ?? 'no')}</span>)}
            </td>
            <td class="muted">{r.tieGuess ? <>{r.tieGuess}<br /><small>{away(r.tieDiff)}</small></> : '-'}</td>
            <td class="pts">{r.points}/{SCORED.length}</td>
          </tr>
        ))}
        {board.rows.length === 0 && <tr><td colspan="5" class="muted">No guests yet.</td></tr>}
      </tbody>
    </table>
  </div>

  {answered && (
    <details class="card">
      <summary><b>Question key</b> (Sybil's answers)</summary>
      <ol class="key">
        {QUESTIONS.map((q) => <li value={num(q.id)}>{q.text} <b>{truths[q.id]?.answer ?? '(not answered)'}</b></li>)}
      </ol>
    </details>
  )}

  <details class="card">
    <summary class="muted">Delete all guest entries (for clearing test data)</summary>
    <form method="POST" action="/api/quiz/clear" class="row" style="margin-top:10px">
      <input type="hidden" name="csrf_token" value={csrf} />
      <input name="confirm" type="text" placeholder="Type DELETE to confirm" autocomplete="off" style="max-width:260px" />
      <button class="btn sm btn-gold" type="submit">Delete entries</button>
    </form>
    <p class="hint">Keeps Sybil's own answers. Cannot be undone.</p>
  </details>

  <details class="card">
    <summary class="muted">Reset EVERYTHING (guests + Sybil's answers, entries reopen)</summary>
    <form method="POST" action="/api/quiz/clear" class="row" style="margin-top:10px">
      <input type="hidden" name="csrf_token" value={csrf} />
      <input name="confirm" type="text" placeholder="Type RESET to confirm" autocomplete="off" style="max-width:260px" />
      <button class="btn sm btn-gold" type="submit">Reset everything</button>
    </form>
    <p class="hint">Back to a fresh quiz, as if nobody had played. Cannot be undone.</p>
  </details>
</Base>

<style>
  .nav { display:flex; gap:14px; align-items:center; flex-wrap:wrap }
  .sm { padding:8px 12px; font-size:.92rem }
  .row { display:flex; gap:10px; align-items:center; flex-wrap:wrap; justify-content:space-between }
  .podium { display:flex; gap:10px; margin:16px 0; flex-wrap:wrap }
  .pod { flex:1 1 150px; background:#fff; border:2px solid var(--line); border-radius:var(--radius); padding:14px; text-align:center; box-shadow:var(--shadow) }
  .pod.p1 { border-color:var(--gold); background:#FFFDF5 }
  .medal { font-size:2.2rem }
  .pname { font-weight:700; font-size:1.15rem; word-break:break-word }
  .ppts { font-size:2rem; font-weight:800; color:var(--teal-dark) }
  .ppts small { font-size:1rem; color:var(--muted) }
  .ptie { font-size:.8rem; color:var(--warn) }
  .lb td { vertical-align:middle }
  .rank { font-size:1.2rem; font-weight:800; color:var(--teal-dark); white-space:nowrap }
  .pts { font-size:1.2rem; font-weight:800; white-space:nowrap }
  .pills { display:flex; flex-wrap:wrap; gap:3px; min-width:220px }
  .pill { border-radius:8px; padding:1px 6px; font-size:.75rem; font-weight:700; white-space:nowrap }
  .pill.match { background:#d8f0e2; color:var(--ok) }
  .pill.maybe { background:var(--gold-soft); color:var(--warn) }
  .pill.no { background:#f6dcdc; color:var(--danger) }
  .key li { margin:6px 0 }
</style>
